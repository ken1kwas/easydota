{
  "name": "easydota",
  "productName": "EasyDota",
  "version": "1.0.0",
  "description": "Dota 2 mod patcher & toolkit",
  "author": "ken1kwas",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "dist/app/electron-main.js",
  "bin": {
    "easydota": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix Minify/ui/web install && npm --prefix Minify/ui/web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "start": "npm run build && electron .",
    "cli": "node dist/cli.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "dist": "npm run build && npm run build:web && electron-builder --publish never",
    "dist:win": "npm run build && npm run build:web && electron-builder --win --publish never",
    "dist:linux": "npm run build && npm run build:web && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "io.github.ken1kwas.easydota",
    "productName": "EasyDota",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/tests/**",
      "!dist/**/*.map",
      "!dist/**/*.d.ts",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "Minify",
        "to": "data",
        "filter": [
          "mods/**",
          "!mods/D2PFX */**",
          "!mods/D2PFX *",
          "bin/**",
          "locales/**",
          "themes/**",
          "plugins/*/manifest.json",
          "plugins/*/*.ts",
          "plugins/*/locales/**",
          "plugins/*/ui/**",
          "ui/web/dist/**"
        ]
      },
      "LICENSE",
      "README.md"
    ],
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Game"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "adm-zip": "^0.5.16",
    "commander": "^12.1.0",
    "jsonc-parser": "^3.3.1",
    "tar": "^7.4.3",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
